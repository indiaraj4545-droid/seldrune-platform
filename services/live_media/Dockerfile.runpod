FROM runpod/pytorch:1.0.2-cu1281-torch280-ubuntu2404

ARG FACEFUSION_COMMIT=358f169e95e2b02431722cc287db8acda6658df1
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    FACEFUSION_ROOT=/opt/facefusion \
    SELDRUNE_RUNPOD_JOB_DIR=/workspace/seldrune-faceswap-jobs

RUN apt-get update && apt-get install -y --no-install-recommends \
      ffmpeg git fonts-dejavu-core libgl1 libglib2.0-0 libgomp1 \
    && rm -rf /var/lib/apt/lists/*

RUN git clone https://github.com/facefusion/facefusion.git /opt/facefusion \
    && git -C /opt/facefusion checkout "${FACEFUSION_COMMIT}" \
    && cd /opt/facefusion \
    && python install.py cuda@12 --skip-conda \
    && python -c "import onnxruntime as ort; assert 'CUDAExecutionProvider' in ort.get_available_providers()"

# RunPod GPU telemetry can contain nonnumeric values such as N/A. The pinned
# FaceFusion parser previously passed those values to int() and aborted CUDA
# provider setup; treat unavailable telemetry as absent and verify the patch.
RUN cd /opt/facefusion \
    && python -c 'from pathlib import Path; p = Path("facefusion/execution.py"); source = p.read_text(); start = source.index("def create_value_and_unit("); end = source.find("\ndef ", start + 1); end = len(source) if end < 0 else end; old = source[start:end].rstrip(); tab = chr(9); replacement = "\n".join(["def create_value_and_unit(text : str) -> Optional[ValueAndUnit]:", tab + "if not isinstance(text, str):", tab + tab + "return None", tab + "parts = text.split(maxsplit=1)", tab + "if len(parts) != 2:", tab + tab + "return None", tab + "try:", tab + tab + "value = int(parts[0])", tab + "except ValueError:", tab + tab + "return None", tab + "return {\"value\": value, \"unit\": parts[1]}"]); assert old.count("int(value)") == 1; patched = source[:start] + replacement + (source[end:] if end < len(source) else "\n"); compile(patched, str(p), "exec"); p.write_text(patched)' \
    && python -c 'from facefusion.execution import create_value_and_unit; assert create_value_and_unit("N/A %") is None; assert create_value_and_unit(None) is None; assert create_value_and_unit("4096 MiB") == {"value": 4096, "unit": "MiB"}'

# Fetch only the configured swap model and the common modules required by its
# pinned pre_check API. Hash validation and a bounded command fail the build on
# unavailable/corrupt assets; no GPU or user media is needed.
COPY services/live_media/prefetch_facefusion_models.py /opt/facefusion/prefetch_facefusion_models.py
RUN cd /opt/facefusion && timeout 1800s python prefetch_facefusion_models.py

RUN python -m pip install --no-cache-dir \
      'fastapi>=0.115,<1.0' \
      'uvicorn[standard]>=0.32,<1.0' \
      'python-multipart>=0.0.20,<1.0'

WORKDIR /app
COPY services/live_media/runpod_facefusion_worker.py /app/runpod_facefusion_worker.py
EXPOSE 8000
CMD ["uvicorn", "runpod_facefusion_worker:app", "--host", "0.0.0.0", "--port", "8000"]
